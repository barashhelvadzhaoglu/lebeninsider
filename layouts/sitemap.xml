{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- /* LebenInsider: etiket ve kategori sayfalari sitemap'e eklenmiyor */ -}}
  {{ range where .Pages "Sitemap.Disable" "ne" true }}{{ if and .Permalink (not (in (slice "taxonomy" "term") .Kind)) (not (in (string .Site.Params.robots) "noindex")) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
  </url>{{ end }}{{ end }}
</urlset>
